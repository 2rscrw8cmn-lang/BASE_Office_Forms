{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "worker-configuration.d.ts",
    "functions/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "*.config.mts"
  ]
}
